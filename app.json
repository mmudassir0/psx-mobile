{
  "expo": {
    "name": "Sahm",
    "slug": "sahm-app",
    "scheme": "sahm",
    "version": "0.65.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mudassir.sahm"
    },
    "android": {
      "package": "com.mudassir.sahm",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5B83D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sahm reads your broker screenshots to fill in your holdings.",
          "cameraPermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Portfolio",
              "label": "Sahm portfolio",
              "description": "Your portfolio value, today's change, the next dividend and any reminder",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Watchlist",
              "label": "Sahm watchlist",
              "description": "Prices and today's change for your watchlist",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-watch-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Market",
              "label": "Sahm market",
              "description": "KSE-100, KMI-30 and other indices, and how many stocks are up",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-market-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Stock",
              "label": "Sahm stock",
              "description": "One stock you choose: price, today's change and a 3-month chart",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-stock-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8B04B"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Sahm adds book closures and dividend payments for your holdings to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_trade": {
              "foregroundImage": "./assets/shortcut-trade.png",
              "backgroundColor": "#161E29"
            },
            "shortcut_watch": {
              "foregroundImage": "./assets/shortcut-watch.png",
              "backgroundColor": "#161E29"
            },
            "shortcut_market": {
              "foregroundImage": "./assets/shortcut-market.png",
              "backgroundColor": "#161E29"
            },
            "shortcut_ai": {
              "foregroundImage": "./assets/shortcut-ai.png",
              "backgroundColor": "#161E29"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sahm records your spoken question so the AI can answer it."
        }
      ],
      "expo-asset",
      "expo-background-task"
    ]
  }
}
